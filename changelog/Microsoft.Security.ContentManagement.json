          "Id": "ceb7818b-ad51-47cb-a23d-53a9214e6e03",
          "ApiChange": "Resource",
          "ChangedApiName": "contentPackageBase",
          "ChangeType": "Addition",
          "Description": "Added the abstract [contentPackageBase](https://learn.microsoft.com/en-us/graph/api/resources/security-contentmanagement-contentpackagebase?view=graph-rest-beta) resource type for shared package identity and publisher metadata. It has no endpoint of its own.",
          "Target": "contentPackageBase"
        },
        {
          "Id": "ceb7818b-ad51-47cb-a23d-53a9214e6e03",
          "ApiChange": "Resource",
          "ChangedApiName": "contentPackage",
          "ChangeType": "Change",
          "Description": "Updated [contentPackage](https://learn.microsoft.com/en-us/graph/api/resources/security-contentmanagement-contentpackage?view=graph-rest-beta) to inherit shared publisher metadata from [contentPackageBase](https://learn.microsoft.com/en-us/graph/api/resources/security-contentmanagement-contentpackagebase?view=graph-rest-beta). Existing endpoints, response properties, and query capabilities are unchanged.",
          "Target": "contentPackage"
        },
        {
          "Id": "ceb7818b-ad51-47cb-a23d-53a9214e6e03",
          "ApiChange": "Resource",
          "ChangedApiName": "installedPackage",
          "ChangeType": "Change",
          "Description": "Updated [installedPackage](https://learn.microsoft.com/en-us/graph/api/resources/security-contentmanagement-installedpackage?view=graph-rest-beta) to inherit shared publisher metadata from [contentPackageBase](https://learn.microsoft.com/en-us/graph/api/resources/security-contentmanagement-contentpackagebase?view=graph-rest-beta). Existing endpoints, response properties, and write behavior are unchanged.",
          "Target": "installedPackage"
        }
      ],
