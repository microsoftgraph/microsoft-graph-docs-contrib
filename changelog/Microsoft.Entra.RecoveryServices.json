{
  "changelog": [
    {
      "ChangeList": [
        {
          "Id": "f68de95e-c291-4675-8810-876bdce5108d",
          "ApiChange": "Resource",
          "ChangedApiName": "recoveryConfiguration",
          "ChangeType": "Addition",
          "Description": "Added the [recoveryConfiguration](https://learn.microsoft.com/en-us/graph/api/resources/entrarecoveryservices-recoveryconfiguration?view=graph-rest-beta) resource to represent a tenant's Microsoft Entra Backup and Recovery configuration.",
          "Target": "recoveryConfiguration"
        },
        {
          "Id": "f68de95e-c291-4675-8810-876bdce5108d",
          "ApiChange": "ComplexType",
          "ChangedApiName": "premiumPlanConfiguration",
          "ChangeType": "Addition",
          "Description": "Added the [premiumPlanConfiguration](https://learn.microsoft.com/en-us/graph/api/resources/entrarecoveryservices-premiumplanconfiguration?view=graph-rest-beta) complex type to represent the premium plan status and most recent enablement timestamp.",
          "Target": "premiumPlanConfiguration"
        },
        {
          "Id": "f68de95e-c291-4675-8810-876bdce5108d",
          "ApiChange": "Relationship",
          "ChangedApiName": "configuration",
          "ChangeType": "Addition",
          "Description": "Added the read-only **configuration** relationship to the [recovery](https://learn.microsoft.com/en-us/graph/api/resources/entrarecoveryservices-recovery?view=graph-rest-beta) resource.",
          "Target": "recovery"
        },
        {
          "Id": "f68de95e-c291-4675-8810-876bdce5108d",
          "ApiChange": "Method",
          "ChangedApiName": "Get configuration",
          "ChangeType": "Addition",
          "Description": "Added the [Get configuration](https://learn.microsoft.com/en-us/graph/api/entrarecoveryservices-recoveryconfiguration-get?view=graph-rest-beta) API to read a tenant's premium plan configuration.",
          "Target": "recoveryConfiguration"
        },
        {
          "Id": "f68de95e-c291-4675-8810-876bdce5108d",
          "ApiChange": "Property",
          "ChangedApiName": "servicePlan",
          "ChangeType": "Addition",
          "Description": "Added the read-only **servicePlan** property to the [snapshot](https://learn.microsoft.com/en-us/graph/api/resources/entrarecoveryservices-snapshot?view=graph-rest-beta) resource to identify its service-assigned plan.",
          "Target": "snapshot"
        },
        {
          "Id": "f68de95e-c291-4675-8810-876bdce5108d",
          "ApiChange": "Property",
          "ChangedApiName": "servicePlan",
          "ChangeType": "Addition",
          "Description": "Added the read-only **servicePlan** property to [recoveryJobBase](https://learn.microsoft.com/en-us/graph/api/resources/entrarecoveryservices-recoveryjobbase?view=graph-rest-beta) and its derived job types to identify the service-assigned plan used to process a job.",
          "Target": "recoveryJobBase"
        },
        {
          "Id": "f68de95e-c291-4675-8810-876bdce5108d",
          "ApiChange": "Enumeration",
          "ChangedApiName": "snapshotTier",
          "ChangeType": "Addition",
          "Description": "Added the **snapshotTier** enumeration with **basic**, **premium**, and **unknownFutureValue** members for the service plan of [snapshots](https://learn.microsoft.com/en-us/graph/api/resources/entrarecoveryservices-snapshot?view=graph-rest-beta#snapshottier-values) and recovery jobs.",
          "Target": "snapshotTier"
        },
        {
          "Id": "f68de95e-c291-4675-8810-876bdce5108d",
          "ApiChange": "Enumeration",
          "ChangedApiName": "premiumPlanStatus",
          "ChangeType": "Addition",
          "Description": "Added the **premiumPlanStatus** enumeration with **disabled**, **enabled**, **protectionPaused**, **billingStopped**, and **unknownFutureValue** members for [premiumPlanConfiguration](https://learn.microsoft.com/en-us/graph/api/resources/entrarecoveryservices-premiumplanconfiguration?view=graph-rest-beta).",
          "Target": "premiumPlanStatus"
        }
      ],
